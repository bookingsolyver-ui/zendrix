# Gerado automaticamente por scripts/deploy-openwa.sh (permissões 600). NUNCA vai para o git.
OPENWA_DOMAIN=wa.kwanzaflow.com
ACME_EMAIL=
API_MASTER_KEY=            # openssl rand -hex 32 (mín. 32 caracteres; o OpenWA recusa valores fracos)
OPENWA_VERSION=latest      # fixe uma versão (ex.: 0.24.0) em produção
OPENWA_MEM_LIMIT=2g
TZ=UTC
