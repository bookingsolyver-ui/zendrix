generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Uma organização (tenant) do SaaS. Todos os dados de um cliente pendem de um Workspace.
model Workspace {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  ownerEmail         String?             @map("owner_email")
  stripeCustomerId   String?             @unique @map("stripe_customer_id")
  subStatus          String              @default("trialing") @map("sub_status") // trialing | active | past_due | canceled
  plan               String?
  trialEndsAt        DateTime?           @map("trial_ends_at")
  agentEnabled       Boolean             @default(false) @map("agent_enabled") // interruptor do agente desta organização
  agentKnowledge     String?             @map("agent_knowledge") // ficha do negócio: sem ela o agente não responde
  agentProfile       Json?               @map("agent_profile") // os campos da ficha que o cliente edita (compilados para agentKnowledge)
  stripeSubscriptionId String?           @unique @map("stripe_subscription_id") // a subscrição atual (só ela governa o estado)
  stripeEventAt      DateTime?           @map("stripe_event_at") // último evento do Stripe aplicado (ordem não garantida)
  users              User[]
  socialIntegrations SocialIntegration[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
}

model User {
  id          String    @id @default(cuid())
  authId      String?   @unique // Supabase Auth user id (auth.users.id)
  email       String    @unique
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model SocialIntegration {
  id                String    @id @default(cuid())
  workspaceId       String
  platform          String // ex: "WHATSAPP", "INSTAGRAM"
  accessToken       String // cifrado (AES-256-GCM), nunca em texto simples
  providerAccountId String? // phone_number_id do WhatsApp
  wabaId            String?   @map("waba_id") // WhatsApp Business Account do cliente
  status            String    @default("ACTIVE")
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  createdAt         DateTime  @default(now())

  // Um número só pode pertencer a uma organização: é o que permite encaminhar o webhook sem ambiguidade.
  @@unique([platform, providerAccountId])
}

// A customer of a workspace, identified by their WhatsApp ID (the phone number, digits only).
model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  waId          String
  name          String?
  createdAt     DateTime       @default(now())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, waId])
}

// One thread per contact per workspace.
model Conversation {
  id                 String    @id @default(cuid())
  workspaceId        String
  contactId          String
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  isPaused           Boolean   @default(false) @map("is_paused") // true = a human took over: the AI agent stays silent
  createdAt          DateTime  @default(now())
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([workspaceId, contactId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  direction      String // "IN" (from the customer) | "OUT" (sent by us)
  type           String       @default("text")
  body           String
  status         String       @default("RECEIVED") // IN: RECEIVED · OUT: SENT, DELIVERED, READ, FAILED
  waMessageId    String?      @unique // Meta's message id: dedupes webhook retries, matches status updates
  mediaPath      String?      @map("media_path") // object path in the private Storage bucket (customer voice notes)
  errorMessage   String?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
