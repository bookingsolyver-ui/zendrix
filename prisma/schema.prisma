generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Canal de onde vem (ou para onde vai) uma conversa. Os eventos da Meta chegam todos ao mesmo webhook.
enum Platform {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

// Em que ponto está um potencial cliente (lead). Só avança com provas (a IA identificou intenção, um link de
// pagamento foi enviado, o pagamento entrou) e nunca recua de WON. Ver lib/leads/lead.ts.
enum LeadStage {
  NEW
  ENGAGED
  QUALIFIED
  PAYMENT_SENT
  WON
  LOST
}

// Estado de uma mensagem na fila de saída (OutboxMessage).
enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Uma organização (tenant) do SaaS. Todos os dados de um cliente pendem de um Workspace.
model Workspace {
  id                     String              @id @default(cuid())
  name                   String
  createdAt              DateTime            @default(now())
  ownerEmail             String?             @map("owner_email")
  stripeCustomerId       String?             @unique @map("stripe_customer_id")
  subStatus              String              @default("trialing") @map("sub_status") // trialing | active | past_due | canceled
  plan                   String?
  trialEndsAt            DateTime?           @map("trial_ends_at")
  agentEnabled           Boolean             @default(false) @map("agent_enabled") // interruptor do agente desta organização
  agentKnowledge         String?             @map("agent_knowledge") // ficha do negócio: sem ela o agente não responde
  agentProfile           Json?               @map("agent_profile") // os campos da ficha que o cliente edita (compilados para agentKnowledge)
  stripeSubscriptionId   String?             @unique @map("stripe_subscription_id") // a subscrição atual (só ela governa o estado)
  stripeEventAt          DateTime?           @map("stripe_event_at") // último evento do Stripe aplicado (ordem não garantida)
  users                  User[]
  socialIntegrations     SocialIntegration[]
  contacts               Contact[]
  conversations          Conversation[]
  messages               Message[]
  apiKeys                ApiKey[]
  outbox                 OutboxMessage[]
  invites                TeamInvite[]
  // Stripe Connect: a conta Stripe DA EMPRESA, onde caem os pagamentos dos clientes dela (nunca a da Zetrix).
  stripeConnectAccountId String?             @unique @map("stripe_connect_account_id")
  followUpConfig         Json?               @map("follow_up_config") // lib/followups/config.ts
  scheduleConfig         Json?               @map("schedule_config") // lib/schedule/config.ts
  paymentItems           PaymentItem[]
  tasks                  Task[]
  docs                   Doc[]
  segments               Segment[]
  messageTemplates       MessageTemplate[]
  campaigns              Campaign[]
  automations            Automation[]
  popups                 Popup[]
  paymentLinks           PaymentLink[]
  followUps              FollowUp[]
  appointments           Appointment[]
  // Suspensão pela administração da plataforma: sem acesso, sem envios, sem automações. Não apaga nada.
  blockedAt              DateTime?           @map("blocked_at")
  blockedReason          String?             @map("blocked_reason")
  approvalStatus         ApprovalStatus      @default(APPROVED) @map("approval_status")
  approvalDecidedAt      DateTime?           @map("approval_decided_at")
  approvalDecidedBy      String?             @map("approval_decided_by") // User.id do administrador
  approvalNote           String?             @map("approval_note") // motivo da rejeição
  // Do Stripe (webhook ou sincronização manual): quando acaba o período pago e se está marcado para cancelar.
  periodEnd              DateTime?           @map("period_end")
  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")

  @@index([approvalStatus])
}

// Papéis dentro de uma organização (RBAC), do mais para o menos poderoso. lib/roles.ts tem a hierarquia.
// OWNER: tudo, incluindo faturação e chaves de API · MANAGER: gere a equipa e as chaves STAFF · STAFF: opera a inbox.
// Aprovação manual de contas novas (moderação pela administração da plataforma). As organizações que já existiam
// ficam APPROVED; as novas nascem PENDING_APPROVAL (a não ser que REQUIRE_ACCOUNT_APPROVAL=false).
enum ApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id              String    @id @default(cuid())
  authId          String?   @unique // Supabase Auth user id (auth.users.id)
  email           String    @unique
  name            String?
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  // Privilégio mínimo por omissão: quem cria a organização é marcado OWNER explicitamente (lib/auth/provision.ts).
  role            Role      @default(STAFF)
  createdAt       DateTime  @default(now())
  apiKeys         ApiKey[]
  // Administrador da PLATAFORMA (não de uma organização). Só se concede por script no servidor
  // (scripts/make-platform-admin.mjs): nenhuma rota, formulário ou convite escreve este campo.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
}

// Chave de API de uma organização, para clientes externos chamarem o Zetrix (cabeçalho x-api-key).
// Só se guarda o hash SHA-256: a chave completa é mostrada UMA vez, ao ser criada, e não se recupera.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String // primeiros caracteres da chave, para a reconhecer numa lista (não é segredo)
  keyHash     String    @unique
  role        Role      @default(STAFF) // o que esta chave pode fazer; nunca OWNER
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model SocialIntegration {
  id                String    @id @default(cuid())
  workspaceId       String
  // Um valor do enum Platform ("WHATSAPP" | "INSTAGRAM" | "MESSENGER"), guardado como texto para não
  // migrar as linhas que já existem.
  platform          String
  // WhatsApp: token do utilizador de sistema. Messenger: token da PÁGINA do Facebook. Instagram: token da
  // página ligada à conta (ou do Instagram Login). Sempre cifrado (AES-256-GCM), nunca em texto simples.
  accessToken       String
  // O id que a Meta envia nos webhooks (entry.id) e que identifica de quem é o evento:
  // WhatsApp = phone_number_id · Messenger = id da página · Instagram = id da conta profissional.
  providerAccountId String?
  wabaId            String?   @map("waba_id") // WhatsApp Business Account do cliente
  pageId            String?   @map("page_id") // Instagram: página do Facebook ligada à conta, usada para enviar
  tokenExpiresAt    DateTime? @map("token_expires_at") // tokens de utilizador do Instagram expiram (~60 dias)
  // O id (da app) do utilizador do Facebook que ligou este canal. Serve para cumprir o pedido de eliminação de
  // dados da Meta: quando essa pessoa remove a app, apagamos o que ela ligou.
  metaUserId        String?   @map("meta_user_id")
  status            String    @default("ACTIVE")
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  createdAt         DateTime  @default(now())

  // Um número só pode pertencer a uma organização: é o que permite encaminhar o webhook sem ambiguidade.
  @@unique([platform, providerAccountId])
  @@index([metaUserId])
}

// A customer of a workspace, identified by their WhatsApp ID (the phone number, digits only).
model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  platform      Platform       @default(WHATSAPP)
  // Identificador do cliente na plataforma: WhatsApp = número (só dígitos) · Instagram = IGSID · Messenger = PSID.
  waId          String
  name          String?
  // Qualificação comercial (lead): preenchida pela IA durante a conversa e por regras do servidor.
  email         String?
  painPoint     String? // a necessidade/dor principal, nas palavras do cliente (curta)
  leadStage     LeadStage      @default(NEW)
  leadIntent    String? // última intenção identificada: interested | ready_to_buy | not_interested
  qualifiedAt   DateTime?
  // O cliente pediu para não receber mais mensagens automáticas (STOP, parar...). Nunca mais se lhe enviam
  // follow-ups. Não se limpa sozinho: só uma pessoa o pode reverter (com o consentimento dele).
  optedOutAt    DateTime?
  createdAt     DateTime       @default(now())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, platform, waId])
}

// One thread per contact per workspace.
model Conversation {
  id                 String    @id @default(cuid())
  workspaceId        String
  platform           Platform  @default(WHATSAPP)
  contactId          String
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  isPaused           Boolean   @default(false) @map("is_paused") // true = a human took over: the AI agent stays silent
  createdAt          DateTime  @default(now())
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([workspaceId, contactId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  platform       Platform     @default(WHATSAPP)
  direction      String // "IN" (from the customer) | "OUT" (sent by us)
  type           String       @default("text")
  body           String
  status         String       @default("RECEIVED") // IN: RECEIVED · OUT: QUEUED (na fila de saída), SENT, DELIVERED, READ, FAILED
  waMessageId    String?      @unique // Meta's message id: dedupes webhook retries, matches status updates
  mediaPath      String?      @map("media_path") // object path in the private Storage bucket (customer voice notes)
  errorMessage   String?
  // Se é uma mensagem de seguimento automático (reengajamento), o passo (1, 2, 3...). null = mensagem normal.
  followUpStep   Int?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  // As contagens por organização (painel e faturação) filtram por workspaceId, direção e data.
  @@index([workspaceId, direction, createdAt])
}

// Contadores do limitador de pedidos (lib/rate-limit.ts). Vivem na base de dados e não na memória: em
// serverless cada instância tem a sua memória, e um limite por instância não limita nada.
// Só o servidor lhes toca (RLS fechado, sem acesso pela API do Supabase).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Horários que a agenda mostrou a um cliente (ferramenta ver_horarios do agente): só se marca o que foi
// oferecido a ESSA pessoa. Na base de dados porque a conversa passa por instâncias diferentes.
model OfferedSlot {
  id          String   @id @default(cuid())
  workspaceId String
  contact     String // número do cliente (waId)
  slot        String // "AAAA-MM-DD HH:MM"
  expiresAt   DateTime

  @@unique([workspaceId, contact, slot])
  @@index([expiresAt])
}

// Fila de saída (outbox): a IA e a Inbox NÃO falam com a Graph API da Meta. Gravam aqui a mensagem e o
// worker (lib/outbox/process.ts, chamado pelo cron e logo após enfileirar) envia com ritmo controlado,
// para centenas de respostas simultâneas não rebentarem os limites da Meta (e não dar má reputação ao número).
model OutboxMessage {
  id            String       @id @default(cuid())
  workspaceId   String
  platform      Platform
  // Validado por lib/validations/outbox.ts: { kind: "text", to, text, conversationId, messageId }.
  // Nunca leva segredos: o token lê-se da integração no momento do envio.
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  errorMessage  String?
  nextAttemptAt DateTime     @default(now()) // não tentar antes (backoff e adiamentos por ritmo)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

// Convite para entrar numa organização. O token só existe no link enviado ao convidado: aqui guarda-se o
// hash, como as chaves de API. Um convite vale 7 dias e uma vez (acceptedAt).
model TeamInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String // em minúsculas
  role        Role      @default(STAFF) // nunca OWNER
  tokenHash   String    @unique
  invitedById String? // User.id de quem convidou
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

// Pedidos de eliminação de dados: o callback da Meta, o formulário público e a eliminação de conta.
// O `code` é o código de confirmação que se mostra ao titular e que a página de estado aceita.
model DataDeletionRequest {
  id          String    @id @default(cuid())
  code        String    @unique
  source      String // "meta_callback" | "web_form" | "account"
  contact     String? // e-mail de quem pediu (só no formulário público)
  metaUserId  String?
  status      String    @default("received") // received | completed
  detail      String? // o que foi apagado, sem dados pessoais
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}

// O catálogo do que a IA pode vender com um link de pagamento. A IA escolhe um item; o PREÇO vem sempre daqui,
// nunca do que o modelo "acha". Valores em unidades menores da moeda (cêntimos).
model PaymentItem {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  amountMinor Int // 2990 = 29,90
  currency    String // EUR | USD | GBP | BRL (as que o Stripe aceita)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

// Um link de pagamento enviado a um cliente (sessão de Checkout na conta Stripe da empresa).
model PaymentLink {
  id              String    @id @default(cuid())
  workspaceId     String
  conversationId  String?
  contactId       String?
  itemName        String // fotografia do item no momento (o catálogo pode mudar depois)
  amountMinor     Int
  currency        String
  stripeSessionId String    @unique
  url             String
  status          String    @default("OPEN") // OPEN | PAID | EXPIRED
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Registo de cada seguimento automático decidido. A restrição única é o que impede dois workers de
// enviarem o MESMO seguimento: quem consegue inserir a linha, envia; o outro vê o conflito e salta.
model FollowUp {
  id              String    @id @default(cuid())
  workspaceId     String
  conversationId  String
  anchorInboundId String // a última mensagem do cliente quando se decidiu (a "âncora" da sequência)
  step            Int // 1, 2, 3...
  status          String // QUEUED | SKIPPED | FAILED
  reason          String?
  messageId       String?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, anchorInboundId, step])
  @@index([workspaceId, createdAt])
}

// Uma marcação feita pela IA (ou à mão). Nativa: a disponibilidade vem da configuração da organização.
// `slotKey` (= início em ISO) só existe enquanto a marcação está CONFIRMED, e é único por organização: dois
// pedidos simultâneos para a mesma hora não podem ambos entrar. Ao cancelar fica null e a hora volta a estar livre.
model Appointment {
  id             String    @id @default(cuid())
  workspaceId    String
  conversationId String?
  contactId      String?
  customerName   String
  customerEmail  String?
  service        String?
  startsAt       DateTime
  endsAt         DateTime
  status         String    @default("CONFIRMED") // CONFIRMED | CANCELLED
  slotKey        String?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slotKey])
  @@index([workspaceId, startsAt])
}

// ─── CRM, segmentos e templates ───

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Uma tarefa do quadro do CRM (kanban). A ordem dentro de cada coluna é `position` (crescente).
model Task {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, position])
}

// Um documento partilhado com a equipa (guiões, políticas, notas).
model Doc {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  body         String    @default("")
  lastEditedBy String? // nome (ou e-mail) de quem o guardou por último
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt])
}

// Um segmento dinâmico de contactos: as regras (JSON validado em lib/segments/rules.ts) são avaliadas sempre que se
// conta ou lista, por isso quem entra e sai atualiza-se sozinho.
model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  rules       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Um modelo de mensagem guardado pela organização (rascunho: ainda não é submetido à Meta a partir daqui).
model MessageTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  category    String // UTILITY | MARKETING
  language    String    @default("pt_PT")
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// ─── Campanhas ───

enum CampaignStatus {
  SCHEDULED // à espera da hora marcada (ou de arrancar)
  SENDING // destinatários a ser enfileirados e enviados
  COMPLETED
  FAILED // nenhuma mensagem chegou a ser enfileirada por falha
  CANCELLED
}

enum RecipientStatus {
  PENDING
  PROCESSING
  QUEUED // enfileirada na fila de saída (o estado real de entrega está na Message)
  SKIPPED // não elegível (fora da janela de 24 h, pediu para não receber, sem conversa...)
  FAILED
}

// Um envio em massa a partir de um segmento. As regras do segmento ficam copiadas (`rules`): apagar ou editar o
// segmento depois não muda o que esta campanha faz. A audiência só se calcula quando a campanha arranca.
model Campaign {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  message         String // texto com {{nome}}; é o que se envia
  segmentName     String
  rules           Json
  scheduledAt     DateTime
  status          CampaignStatus      @default(SCHEDULED)
  totalRecipients Int                 @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients      CampaignRecipient[]

  @@index([workspaceId, createdAt])
  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id          String          @id @default(cuid())
  campaignId  String
  workspaceId String
  contactId   String
  status      RecipientStatus @default(PENDING)
  reason      String? // motivo de SKIPPED/FAILED
  messageId   String? // a Message criada (ligada à fila de saída)
  updatedAt   DateTime        @updatedAt
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

// ─── Automações ───

enum AutomationTrigger {
  NEW_CONTACT
  MESSAGE_RECEIVED
  LEAD_QUALIFIED
  PAYMENT_PAID
  POPUP_SUBMITTED
}

enum AutomationStepStatus {
  PENDING
  PROCESSING
  DONE
  SKIPPED
  FAILED
}

// Um fluxo: um gatilho (evento real) e até 3 ações em sequência (cada uma com espera opcional). O motor lê os
// eventos reais (contactos, mensagens, qualificações, pagamentos) a partir de `cursorAt`: uma automação só
// reage ao que acontece DEPOIS de ser ativada.
model Automation {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  trigger     AutomationTrigger
  config      Json // por gatilho (ex.: palavra-chave)
  actions     Json // lista validada em lib/automations/schema.ts
  active      Boolean           @default(false)
  activatedAt DateTime          @default(now()) // quando foi ativada pela última vez: só reage ao que vem depois
  cursorAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@index([workspaceId])
  @@index([active, trigger])
}

// Uma execução: um evento + um contacto. A chave única (automação + evento) é o que impede reexecutar o mesmo
// evento (varrimentos repetidos, dois workers).
model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  workspaceId  String
  contactId    String
  eventKey     String
  createdAt    DateTime            @default(now())
  completedAt  DateTime?
  automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps        AutomationRunStep[]

  @@unique([automationId, eventKey])
  @@index([automationId, contactId, createdAt])
  @@index([workspaceId, createdAt])
}

model AutomationRunStep {
  id          String               @id @default(cuid())
  runId       String
  workspaceId String
  index       Int
  type        String // SEND_MESSAGE | SET_STAGE | CREATE_TASK
  config      Json // cópia da ação no momento (editar a automação não muda execuções em curso)
  dueAt       DateTime
  status      AutomationStepStatus @default(PENDING)
  reason      String?
  doneAt      DateTime?
  updatedAt   DateTime             @updatedAt
  run         AutomationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([status, dueAt])
}

// ─── Popups de captura de leads ───

// Um popup que o cliente cola no seu site com um script. A `publicKey` (não adivinhável) é o que vai no script;
// `config` (validado em lib/popups/schema.ts) manda no aspeto, nos campos e nas regras de exibição.
model Popup {
  id          String            @id @default(cuid())
  workspaceId String
  publicKey   String            @unique
  name        String
  active      Boolean           @default(false)
  config      Json
  views       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  submissions PopupSubmission[]

  @@index([workspaceId, createdAt])
}

// Cada registo feito num popup. Guarda o texto de consentimento que a pessoa aceitou, como prova.
model PopupSubmission {
  id          String   @id @default(cuid())
  popupId     String
  workspaceId String
  contactId   String
  consentText String
  createdAt   DateTime @default(now())
  popup       Popup    @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@index([popupId, createdAt])
  @@index([workspaceId, createdAt])
}

// Registo de tudo o que um administrador da plataforma faz sobre as organizações (e de cada vez que abre uma para
// a inspecionar). Sem chave estrangeira: o histórico sobrevive à eliminação da organização ou do administrador.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  workspaceId String?
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
}
