generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  users              User[]
  socialIntegrations SocialIntegration[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
}

model User {
  id          String    @id @default(cuid())
  authId      String?   @unique // Supabase Auth user id (auth.users.id)
  email       String    @unique
  name        String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model SocialIntegration {
  id                String    @id @default(cuid())
  workspaceId       String
  platform          String // ex: "WHATSAPP", "INSTAGRAM"
  accessToken       String
  providerAccountId String?
  status            String    @default("ACTIVE")
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  createdAt         DateTime  @default(now())
}

// A customer of a workspace, identified by their WhatsApp ID (the phone number, digits only).
model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  waId          String
  name          String?
  createdAt     DateTime       @default(now())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, waId])
}

// One thread per contact per workspace.
model Conversation {
  id                 String    @id @default(cuid())
  workspaceId        String
  contactId          String
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  isPaused           Boolean   @default(false) @map("is_paused") // true = a human took over: the AI agent stays silent
  createdAt          DateTime  @default(now())
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@unique([workspaceId, contactId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  workspaceId    String
  conversationId String
  direction      String // "IN" (from the customer) | "OUT" (sent by us)
  type           String       @default("text")
  body           String
  status         String       @default("RECEIVED") // IN: RECEIVED · OUT: SENT, DELIVERED, READ, FAILED
  waMessageId    String?      @unique // Meta's message id: dedupes webhook retries, matches status updates
  mediaPath      String?      @map("media_path") // object path in the private Storage bucket (customer voice notes)
  errorMessage   String?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
