# Zentrix — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou cole na Vercel (Project → Settings → Environment Variables).
# NUNCA ponha valores reais neste ficheiro: ele vai para o repositório.
# [obrigatória] = a app não funciona sem ela · [opcional] = tem valor por omissão no código.

# ─── Base de dados (Supabase / PostgreSQL) ─────────────────────────────────────
# Pooler em modo transação (porta 6543). É a que a app usa em runtime.
DATABASE_URL=                       # [obrigatória] postgresql://postgres.<ref>:<password>@aws-1-<região>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Ligação de sessão (porta 5432). Só o CLI do Prisma a usa (db push): NÃO é preciso na Vercel.
DIRECT_URL=
DATABASE_POOL_MAX=                  # [opcional] ligações por instância em serverless (por omissão: 3 na Vercel)

# ─── Supabase Auth e Storage ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=           # [obrigatória] https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # [obrigatória] chave "anon" (pública por desenho)
SUPABASE_SERVICE_ROLE_KEY=          # [obrigatória p/ notas de voz] SECRETA: ignora todas as regras de acesso
SUPABASE_MEDIA_BUCKET=              # [opcional] por omissão: whatsapp-media

# ─── Segurança dos dados ───────────────────────────────────────────────────────
# 32 bytes em base64 (openssl rand -base64 32). Cifra os tokens da Meta na base de dados.
# TEM de ser sempre o mesmo valor: se mudar, os tokens guardados ficam ilegíveis.
INTEGRATION_ENCRYPTION_KEY=         # [obrigatória]

# ─── WhatsApp / Meta ───────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=              # [obrigatória] o "Verify Token" do webhook na Meta
META_APP_SECRET=                    # [obrigatória] Definições → Básico → Chave secreta da app (assina o webhook)
# O token de acesso da Meta NÃO é variável de ambiente: guarda-se cifrado, na base de dados
# (Definições → WhatsApp → Atualizar Token).

# ─── Agente de IA ──────────────────────────────────────────────────────────────
AGENT_ENABLED=false                 # interruptor geral do agente
OPENROUTER_API_KEY=                 # [obrigatória p/ o agente]
MODELO=qwen/qwen3.8-27b:free        # modelo principal
MODELO_FALLBACKS=                   # [opcional] recursos separados por vírgula; vazio = só o principal
MODELO_ORCAMENTO_MS=                # [opcional] tempo máximo total do modelo (por omissão 40000)
FUSO=Europe/Lisbon

# ─── Voz: ouvir (notas de voz recebidas) ───────────────────────────────────────
AUDIO_INBOUND=false                 # transcreve notas de voz de clientes (envia o áudio à Groq/OpenAI)
GROQ_API_KEY=                       # transcrição (Whisper). Tem prioridade sobre a OpenAI
STT_PROVIDER=                       # [opcional] "groq" | "openai" para forçar um
GROQ_STT_MODEL=                     # [opcional] por omissão: whisper-large-v3
WHISPER_LANGUAGE=pt

# ─── Voz: falar (respostas em nota de voz) ─────────────────────────────────────
AGENT_VOICE=false
AGENT_VOICE_MODE=mirror             # mirror = voz só quando o cliente falou · always = sempre
AGENT_VOICE_MAX_CHARS=500
TTS_PROVIDER=elevenlabs             # elevenlabs | openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # [opcional] por omissão: voz "Sarah"
ELEVENLABS_MODEL=                   # [opcional] por omissão: eleven_multilingual_v2
OPENAI_API_KEY=                     # [opcional] só se usar OpenAI para TTS/transcrição
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=                   # [opcional] por omissão: tts-1
WHISPER_MODEL=                      # [opcional] por omissão (OpenAI): whisper-1

# ─── Agenda (Cal.com) — DESLIGADA no código (AGENDAMENTO_ATIVO = false) ────────
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_EMAIL_PADRAO=

# ─── Stripe (estado da subscrição → liga/desliga o agente) ─────────────────────
# Segredo de assinatura do endpoint /api/stripe/webhook (Stripe → Developers → Webhooks → whsec_...).
# Vários segredos separados por vírgula servem para rodar a chave sem falhas. Sem ele o endpoint responde 503.
STRIPE_WEBHOOK_SECRET=
# Chave secreta da API (Stripe → Developers → API keys → sk_...). Só no servidor. Sem ela /api/stripe/* responde 503.
STRIPE_SECRET_KEY=
# Preço do plano único (Stripe → Product catalog → price_...).
STRIPE_PRICE_ID=
# Opcionais: fixar a versão da API do Stripe; URL público para os regressos do Checkout/portal.
STRIPE_API_VERSION=
NEXT_PUBLIC_APP_URL=

# ─── Fila de saída (Meta) ──────────────────────────────────────────────────────
# Segredo do cron da Vercel. Com ele definido, a Vercel envia "Authorization: Bearer <valor>" ao chamar
# /api/cron/process-outbox; sem ele a rota responde 503. Gere um aleatório: openssl rand -hex 32
CRON_SECRET=
# Opcionais: teto de mensagens por segundo por conta da Meta (por omissão 20) e versão da Graph API (por omissão v17.0).
OUTBOX_PER_SECOND=
META_GRAPH_VERSION=

# ─── Ligar canais (Facebook Login) ─────────────────────────────────────────────
# O ID da app da Meta (Definições → Básico). É público (NEXT_PUBLIC_), vai no link para o Facebook; o
# META_APP_SECRET (acima) fica só no servidor. Defina-os na Vercel ANTES do build: NEXT_PUBLIC_ é incorporado no build.
# No painel da Meta, em "Valid OAuth Redirect URIs", adicione: https://<o-seu-dominio>/api/meta/oauth
NEXT_PUBLIC_META_APP_ID=
# Opcional (Facebook Login for Business): o ID da "configuração" criada no painel. Com ele, as permissões vêm da
# configuração e os scopes deixam de ser enviados no link.
NEXT_PUBLIC_META_CONFIG_ID=
